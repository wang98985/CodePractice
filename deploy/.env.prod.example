# 生产环境变量模板：复制为 deploy/.env.prod 后按需修改（.env.prod 已被 .gitignore 忽略）
# 用途：docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
# 公网 IP / 域名，逗号分隔
ALLOWED_HOSTS=101.37.70.252,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://101.37.70.252

# ---- MySQL ----
DB_NAME=oj_platform
DB_USER=oj
DB_PASSWORD=change-me
DB_HOST=mysql
DB_PORT=3306
MYSQL_ROOT_PASSWORD=change-me

# ---- MQ Broker（容器内网地址）----
CELERY_BROKER_URL=redis://redis:6379/0

# ---- CORS（前后端同域经 Nginx 反代，可不配置）----
CORS_ALLOWED_ORIGINS=http://101.37.70.252

# ---- 邮箱（注册验证码）----
EMAIL_HOST_USER=1606383294@qq.com
EMAIL_HOST_PASSWORD=

# ---- AI 助理（留空则降级为本地规则回复）----
AI_API_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# ---- 判题沙箱 ----
SANDBOX_DIR=/tmp/oj_sandbox