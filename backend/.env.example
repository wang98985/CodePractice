SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ---- MySQL ----
DB_NAME=oj_platform
DB_USER=oj
DB_PASSWORD=oj_pass_123
DB_HOST=127.0.0.1
DB_PORT=3306

# ---- MQ Broker ----
# 开发环境推荐 Redis；生产可用 RabbitMQ（删除 CELERY_BROKER_URL 即回退 RABBITMQ_URL）
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672//

# ---- Email (注册验证码) ----
# EMAIL_HOST_PASSWORD 填 QQ 邮箱 SMTP 授权码；留空时验证码打印在 Django 控制台
EMAIL_HOST_USER=1606383294@qq.com
EMAIL_HOST_PASSWORD=

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- AI Assistant (OpenAI-compatible; leave AI_API_KEY empty to use local fallback) ----
AI_API_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=60
